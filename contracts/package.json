{
  "name": "qf-api-contracts",
  "private": true,
  "description": "Pinned tooling for API contract gates: Spectral (AsyncAPI lint) and GraphQL Inspector (breaking changes).",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "lint:events": "spectral lint asyncapi/*.yaml --ruleset .spectral.yaml --fail-severity warn",
    "check:events": "node scripts/check-event-contracts.mjs",
    "check:graphql": "bash scripts/check-graphql-breaking.sh"
  },
  "devDependencies": {
    "@graphql-inspector/cli": "7.0.2",
    "@stoplight/spectral-cli": "6.17.1",
    "graphql": "16.11.0",
    "yaml": "2.9.1"
  }
}
