root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
insert_final_newline = true
charset = utf-8

[*.{json,yml,yaml,tf,tfvars,hcl,xml,props,csproj}]
indent_size = 2

[*.cs]
csharp_style_namespace_declarations = file_scoped:warning
dotnet_style_qualification_for_field = false:suggestion
csharp_style_var_for_built_in_types = true:suggestion
# Result<T>.Success/Failure factories are deliberate static members on a generic type.
dotnet_diagnostic.CA1000.severity = none
# Domain events and value objects are records; GetHashCode/equality is compiler-generated.
dotnet_diagnostic.CA1067.severity = none
# Hot Chocolate and EF Core resolve public types by reflection; internal-by-default does not apply.
dotnet_diagnostic.CA1515.severity = none
# C#-only codebase; VB keyword clashes (e.g. 'Error') are irrelevant.
dotnet_diagnostic.CA1716.severity = none

[**/Generated/*.g.cs]
generated_code = true
